#!/usr/bin/env ruby

# Retrieves the FAA's active Temporary Flight Restrictions and writes them as
# JSON or GeoJSON.
#
# Sources (the tfr.faa.gov site that replaced tfr2/list.html in 2025):
#   - list:     https://tfr.faa.gov/tfrapi/exportTfrList (JSON, every active TFR)
#   - shapes:   the site's GeoServer WFS layer TFR:V_TFR_LOC (GeoJSON polygons)
#
# TFRs without a shape in the WFS layer (mostly standing security notices
# described only in text; their XML has no boundary either) are kept in the
# JSON output and left out of the GeoJSON.
#
# Exits non-zero when the list or the shapes cannot be retrieved, so the
# workflow fails instead of committing an empty file.
#
# Prerequisites:
#   gem install slop

require 'net/http'
require 'json'
require 'slop'

opts = Slop::Options.new
opts.banner = "usage: faa_get_tfrs [options] <path-to-output-file>"
opts.string '-f', '--format', 'output format (default: json, available: json/geojson)', default: 'json'

params = Slop::Parser.new(opts).parse(ARGV)

if params.arguments.size < 1
  puts opts
  exit 1
end

OUTPUT_FILE = params.arguments[0]

SITE_URL = ENV.fetch('TFR_SITE_URL', 'https://tfr.faa.gov')
LIST_URL = "#{SITE_URL}/tfrapi/exportTfrList"
WFS_URL  = "#{SITE_URL}/geoserver/TFR/ows?service=WFS&version=1.1.0&request=GetFeature" \
           '&typeName=TFR:V_TFR_LOC&maxFeatures=1000&outputFormat=application/json&srsname=EPSG:4326'
USER_AGENT = 'airframesio-data (+https://github.com/airframesio/data)'

def http_get(url)
  uri = URI.parse(url)
  http = Net::HTTP.new(uri.host, uri.port)
  http.use_ssl = uri.scheme == 'https'
  http.open_timeout = 20
  http.read_timeout = 60
  http.get(uri.request_uri, 'User-Agent' => USER_AGENT, 'Accept' => '*/*')
end

def get_json!(url, what)
  res = http_get(url)
  abort "Error: #{what} returned HTTP #{res.code}" unless res.code == '200'
  JSON.parse(res.body)
rescue JSON::ParserError => e
  abort "Error: #{what} was not JSON (#{e.message})"
end

# "6/9306" -> "6_9306"
def notam_path(notam)
  notam.tr('/', '_')
end

puts "Retrieving list of TFRs"
list = get_json!(LIST_URL, 'TFR list')
abort 'Error: TFR list is not an array' unless list.is_a?(Array)

puts "Retrieving TFR shapes"
wfs = get_json!(WFS_URL, 'TFR shapes')
abort 'Error: TFR shapes have no features' unless wfs['features'].is_a?(Array)

# NOTAM_KEY looks like "6/9306-1-FDC-F"; one NOTAM can have several shapes.
shapes = Hash.new { |h, k| h[k] = [] }
wfs['features'].each do |feature|
  key = feature.dig('properties', 'NOTAM_KEY').to_s.split('-').first
  geometry = feature['geometry']
  next if key.nil? || key.empty? || geometry.nil?
  polygons = case geometry['type']
             when 'Polygon' then [geometry['coordinates']]
             when 'MultiPolygon' then geometry['coordinates']
             else []
             end
  shapes[key].concat(polygons)
end

tfrs = list.map do |item|
  notam = item['notam_id'].to_s
  detail = "#{SITE_URL}/tfr3/?page=detail_#{notam_path(notam)}"
  xml = "#{SITE_URL}/download/detail_#{notam_path(notam)}.xml"
  polygons = shapes[notam]
  {
    notam: notam,
    type: item['type'],
    facility: item['facility'],
    state: item['state'],
    description: item['description'],
    date: item['creation_date'],
    links: { details: detail, xml: xml },
    polygons: polygons
  }
end

shaped = tfrs.count { |tfr| tfr[:polygons].any? }

case params[:format]
when 'json'
  content = {
    resource_type: 'tfr',
    attribution: { name: 'FAA', url: "#{SITE_URL}/tfr3/" },
    count: tfrs.size,
    tfrs: tfrs.map { |tfr| tfr.reject { |k, _| k == :polygons }.merge(has_geometry: tfr[:polygons].any?) }
  }
when 'geojson'
  content = {
    type: 'FeatureCollection',
    features: tfrs.select { |tfr| tfr[:polygons].any? }.map do |tfr|
      {
        type: 'Feature',
        id: tfr[:notam],
        geometry: if tfr[:polygons].size == 1
                    { type: 'Polygon', coordinates: tfr[:polygons].first }
                  else
                    { type: 'MultiPolygon', coordinates: tfr[:polygons] }
                  end,
        properties: {
          name: tfr[:description],
          notam: tfr[:notam],
          type: tfr[:type],
          facility: tfr[:facility],
          state: tfr[:state],
          url: tfr[:links][:details]
        }
      }
    end
  }
else
  abort "Unknown output format '#{params[:format]}', not saving."
end

File.write(OUTPUT_FILE, JSON.pretty_generate(content))
puts "Retrieved #{tfrs.size} TFRs (#{shaped} with shapes) and wrote to #{OUTPUT_FILE}."
